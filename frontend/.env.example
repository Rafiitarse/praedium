# Praedium frontend — environment template
# Copy to .env.local (gitignored) and fill in.
# WARNING: every NEXT_PUBLIC_* value is compiled into the PUBLIC client bundle.

# ── Wallet connect (Reown AppKit — cloud.reown.com) ──
NEXT_PUBLIC_REOWN_PROJECT_ID=YOUR_REOWN_PROJECT_ID

# ── RPC ──
# Public RPC (no key, safe to expose). Swap for your own Alchemy/Infura URL
# only if you need higher limits — that would expose the key in the public bundle.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Subgraph (filled after `graph deploy`) ──
NEXT_PUBLIC_SUBGRAPH_URL=

# ── Deployed contract addresses (filled after Sepolia deploy) ──
NEXT_PUBLIC_RWA_TOKEN_ADDRESS_SEPOLIA=
NEXT_PUBLIC_COMPLIANCE_REGISTRY_ADDRESS_SEPOLIA=
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS_SEPOLIA=
