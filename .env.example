# Sepolia deployment template — copy to .env (gitignored) and fill in.
# NEVER commit real keys.

# Funded deployer (broadcast signer)
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: broadcast signer key (alternatively forge reads cast wallet / --private-key)
# DEPLOYER_PRIVATE_KEY=0x...

# Role holders — on mainnet these must be Safe multisigs
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
OFFICER_ADDRESS=0x0000000000000000000000000000000000000000
MINTER_ADDRESS=0x0000000000000000000000000000000000000000

# Asset metadata
ASSET_URI=ipfs://your-asset-documents-cid

# RPC + verification
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
ETHERSCAN_API_KEY=YOUR_KEY
