# Praedium — Foundry & deploy environment template
# Copy to .env (gitignored) and fill in. NEVER commit real values.

# ── Sepolia RPC (Alchemy / Infura free tier) ──
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ── Contract verification (etherscan.io → API Keys) ──
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Deployer (dedicated dev wallet — never your main wallet) ──
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ── The Graph (thegraph.com/studio → your subgraph → API Keys) ──
GRAPH_DEPLOY_KEY=YOUR_GRAPH_DEPLOY_KEY
SUBGRAPH_SLUG=rwa-assets
